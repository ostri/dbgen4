    {
      size_t max = 0; // NOLINT(misc-const-correctness) - reassigned in the loop below
      for (const auto& el: buffer_description_const())
        max = std::max(el.name.size(), max);
      return max;
    }
    consteval size_t <<class-name>>::max_column_type_name_len() noexcept
