    /** <<pad("--- dump ", 85, "", "", "-")>> */
    [[nodiscard]]str_t <<class-name>>::dump(uint8_t offs) const
    {
      constexpr const char* fmt = R"FMT(
{1}rec: {0:}:{% for el in buf %}
{1}  {<< 5+loop.index*4 >>:{2}} cat: {<< 5+loop.index*4+1 >>:{3}} type: {<< 5+loop.index*4+2 >>:{4}} value: '{<< 5+loop.index*4+3 >>}'{% endfor %})FMT";
      /**
       * one branch, called once per column below, instead of a ternary
       * spelled out at every call site - readability-function-cognitive-complexity
       * counts each inline ternary against this function, and a wide buffer
       * has one per column. Returns by value, not by reference: value is a
       * column's formatted str_t, alive only for this call, so handing back
       * a reference to it (or to a shared "NULL" one) would dangle the
       * moment the caller's temporary goes away.
       */
      const auto or_null = [](bool is_null, const str_t& value) -> str_t // NOLINT(*swappable-parameters)
      { return is_null ? "NULL" : value; };
      str_t offs_str(offs*2UL, '.');
      str_t s;
##    for el in buf
      str_t str_<< el.name >>;
##    endfor
      for (auto n=0UL; n < buffer_size(); n++)
      {
##      for el in buf
        str_<< el.name >> = fmt::format("{}", <<el.dump-value>>);
##      endfor
        s +=  fmt::format(fmt, n, offs_str, max_column_name_len(), max_category_name_len(), max_column_type_name_len(), {%for el in buf%}"<< el.name >>", "<< el.category >>",
        "<< el.storage-raw >>", or_null(is_<< el.name >>_null(n), str_<< el.name >>){% if el != last(buf) %}, {% endif %}{%endfor%});
        }
        return s;
    }

