/** <<pad("--- construction ", 85, "", "", "-")>> */
    <<class-name>>::<<class-name>>(size_t rows) { set_buffer_size(rows); }
    /** <<pad("--- buffer dimension ", 85, "", "", "-")>> */
    void <<class-name>>::resize_storage(size_t rows)
    {
##  for el in buf
      <<el.name>>_.assign(rows, {});
      len_<<el.name>>_.assign(rows, 0);
##  endfor
## if is-param
      row_status_.assign(rows, 0);
## endif
      /** the vectors have just moved - republish the pointers into them */
      // set_buffer_size() (called from the constructor above) reaches this
      // override through <<root-class>>'s non-virtual wrapper, and the call
      // below is to another override that already belongs to <<class-name>>,
      // not to <<root-class>> - safe, but indistinguishable to the analyzer
      // from genuine virtual dispatch out of a base class constructor.
      static_cast<void>(buffer_description_init()); // NOLINT(clang-analyzer-optin.cplusplus.VirtualCall)
      rebuild_row_wise();
    }
    /** <<pad("--- row-wise view, addresses only valid until the next resize ", 85, "", "", "-")>> */
    void <<class-name>>::rebuild_row_wise()
    {
      row_wise_.clear();
      row_wise_.reserve(buffer_size());
      for (size_t row = 0; row < buffer_size(); ++row)
        row_wise_.push_back(row_t{
##  for el in buf
          .<<el.name>> = <<el.name>>_.at(row),
##  endfor
##  for el in buf
          .is_<<el.name>>_null = len_<<el.name>>_.at(row),
##  endfor
        });
    }
    /** <<pad("--- "+class-name+" types init array ", 85, "", "", "-")>> */
    rtl::span_buffer_dscr_init <<class-name>>::buffer_description_init()
    {
        dscr_init_ =
        {{
##        for el in buf
            { <<el.name>>_.data(), len_<<el.name>>_.data(), sizeof(<<el.name>>_.at(0)) },
##        endfor
        }};
        return dscr_init_;
    };
