    /// --- <<class-name>> types init array  --------------------------------------
    span_buffer_dscr_init <<class-name>>::buffer_description_init()
    {
        /// filled into a member, never a function local static: the pointers
        /// are into *this* object, and a static would hand every later
        /// instance the buffers of whichever one called first
        dscr_init_ =
        {{
##        for el in buf
            { <<el.name>>_.data(), len_<<el.name>>_.data(), sizeof(<<el.name>>_[0]) },
##        endfor
        }};
        return dscr_init_;
    };
    /// --- dump    ---------------------------------------------------------------
    [[nodiscard]]std::string <<class-name>>::dump(uint8_t offs) const
    {
      constexpr const char* fmt = R"FMT(
{1}rec: {0:}:{% for el in buf %}
{1}  {<< 5+loop.index*4 >>:{2}} cat: {<< 5+loop.index*4+1 >>:{3}} type: {<< 5+loop.index*4+2 >>:{4}} value: '{<< 5+loop.index*4+3 >>}'{% endfor %})FMT";
      std::string offs_str(offs*2UL, '.');
      std::string s;
      {%for el in buf%}std::string str_<< el.name >>;
      {%endfor%}
      for (auto n=0UL; n < buf_dim; n++)
      {
        {%for el in buf%}str_<< el.name >> = fmt::format("{}", <<el.dump-value>>);
        {%endfor%}
        s +=  fmt::format(fmt, n, offs_str, max_column_name_len(), max_category_name_len(), max_column_type_name_len(), {%for el in buf%}"<< el.name >>", "<< el.category >>",
        "<< el.storage-raw >>", (is_<< el.name  >>_null(n) ? "NULL" : str_<< el.name >>){% if el != last(buf) %}, {% endif %}{%endfor%});
        }
        return s;
    }

