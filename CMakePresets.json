{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Debug",
      "description": "Ninja + Debug + Sanitizers. Compiler is not pinned - CXX=clang++ selects clang for a fresh tree.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Release",
      "description": "Ninja + Release (fast, no sanitizers) + LTO",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_SANITIZERS": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "ninja-profile",
      "displayName": "Profile",
      "description": "Same as Release, plus DWARF debug info for readable stack traces under Linux perf. Sanitizers are off - their overhead would distort the profile. -fno-omit-frame-pointer is already on for every build (see dbgen4_warnings), which perf needs for frame-pointer-based unwinding.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_SANITIZERS": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "ninja-debug",
      "displayName": "Build (Debug)",
      "jobs": 8
    },
    {
      "name": "release",
      "configurePreset": "ninja-release",
      "displayName": "Build (Release)",
      "jobs": 8
    },
    {
      "name": "profile",
      "configurePreset": "ninja-profile",
      "displayName": "Build (Profile)",
      "jobs": 8
    }
  ]
}
