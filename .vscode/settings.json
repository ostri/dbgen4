{
  "files.associations": {
    "cmath": "cpp",
    "initializer_list": "cpp"
  },
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": true,
  "cmake.buildBeforeRun": true,
  "cmake.buildArgs": [
    "--parallel 8"
  ],
  "cmake.buildDirectory": "${workspaceFolder}/build",

  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },
  "[hpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },

  "clangd.arguments": [
    "--background-index",
    "--pretty",
    "--header-insertion=iwyu",
    "--completion-style=detailed",
    "--function-arg-placeholders=false",
    "--clang-tidy",
    "--clang-tidy-checks=-*,readability-*,bugprone-*,performance-*,cppcoreguidelines-*,-readability-avoid-do-while,-misc-static-assert-in-test,-readability-function-cognitive-complexity,-cppcoreguidelines-macro-usage",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],

  "C_Cpp.intelliSenseEngine": "disabled",

  "C_mantic.caseStyle": "snake_case",
  "C_mantic.cpp.accessor.boolGetterIsPrefix": true,
  "C_mantic.cpp.accessor.getterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.accessor.setterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.resolveTypes": true,
  "C_mantic.headerGuard.style": "Add #pragma once"
}