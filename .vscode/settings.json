{
  "files.associations": {
    "cmath": "cpp",
    "initializer_list": "cpp"
  },
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": true,
  "cmake.buildBeforeRun": true,
  "cmake.buildArgs": [
    "-j8"
  ],
  "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
//  "editor.formatOnSave": true,
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
  },
  "[hpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },
  "clangd.arguments": [
    "--clang-tidy",
    "--background-index",
    "--pretty",
    "--fallback-style=Google",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.fallbackFlags": [],
  "C_mantic.caseStyle": "snake_case",
  "C_mantic.cpp.accessor.boolGetterIsPrefix": true,
  "C_mantic.cpp.accessor.getterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.accessor.setterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.resolveTypes": true,
  "C_mantic.headerGuard.style": "Add #pragma once",
}