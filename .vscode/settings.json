{
  // Forces CMake Tools to drive configuration/build through CMakePresets.json
  // (binaryDir build/debug, build/release, build/profile) rather than its
  // legacy kit/variant workflow, which otherwise configures into a plain
  // top-level build/ - out of step with the ninja-debug/-release/-profile
  // directories the command line (and launch.json) expects.
  "cmake.useCMakePresets": "always",
  "files.associations": {
    "cmath": "cpp",
    "initializer_list": "cpp"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },
  "[hpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },
  /// clangd
  "clangd.arguments": [
    "--log=error",
    "--background-index",
    "--pretty",
    "--header-insertion=iwyu",
    "--header-insertion-decorators=false", // no decorators around include
    "--completion-style=bundled",
    // No --compile-commands-dir on purpose: clangd walks up from each source
    // file and finds the compile_commands.json symlink in the repo root by
    // itself. The flag takes a literal path - ${workspaceFolder} is not
    // substituted here - so any value written by hand goes stale or is simply
    // wrong, and clangd then falls back to guessed flags with no include paths.
    "--function-arg-placeholders=false",
    // Runs the checks from .clang-tidy in the editor. It was false, which is
    // why no clang-tidy diagnostic ever appeared in VS Code no matter what the
    // config said - --enable-config below only makes clangd read the file.
    "--clang-tidy=true",
    "--all-scopes-completion",
    "--enable-config" // <<< To aktivira branje .clangd in .clang-tidy datotek
  ],
  "clangd.onConfigChanged": "restart",
  "clangd.checkUpdates": true,
  // "clangd.trace": "messages",
  "clangd.detectExtensionConflicts": true,
  "clangd.enableCodeCompletion": true,
  "clangd.inlayHints.enable": false,
  "C_Cpp.intelliSenseEngine": "disabled",
  ///cmantic
  "C_mantic.caseStyle": "snake_case",
  "C_mantic.cpp.accessor.boolGetterIsPrefix": true,
  "C_mantic.cpp.accessor.getterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.accessor.setterDefinitionLocation": "Generate definition in matching source file",
  "C_mantic.cpp.resolveTypes": true,
  "C_mantic.headerGuard.style": "Add #pragma once",
  "C_mantic.extensions.headerFiles": [
    "hpp"
  ],
  "C_mantic.extensions.sourceFiles": [
    "cpp"
  ],
  "C_mantic.cpp.generateNamespaces": true,
  "C_mantic.alwaysMoveComments": true
}